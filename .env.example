# OCI credentials only. Copy to .env and keep that file local.
OCI_REGION=us-chicago-1
OCI_MODEL_ID=<responses-compatible-model-id-or-model-endpoint-ocid>
OCI_GENAI_PROJECT_ID=<generative-ai-project-ocid-not-compartment-ocid>
# UI: enter the key under OCI connection, or set it here locally.
# CLI: prompts privately if the key is absent or empty.
OCI_GENAI_API_KEY=
# Optional endpoint override (must end in /openai/v1):
# OCI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
# Optional aliases: OCI_MODEL and OCI_OPENAI_PROJECT take precedence.
